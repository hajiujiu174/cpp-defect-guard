enable_testing()
add_executable(codeguard-real-regression codeguard-regression.c)
target_include_directories(codeguard-real-regression PRIVATE "${PROJECT_SOURCE_DIR}/include")
target_link_libraries(codeguard-real-regression PRIVATE libgit2package)
if(NOT DEFINED CODEGUARD_BENCHMARK_REPO_ROOT)
    set(CODEGUARD_BENCHMARK_REPO_ROOT "${CMAKE_CURRENT_BINARY_DIR}/benchmark-runs")
endif()
string(SHA256 benchmark_observation "${CMAKE_CURRENT_BINARY_DIR}")
string(SUBSTRING "${benchmark_observation}" 0 10 benchmark_observation)
foreach(case head-lock worktree-read-lock control)
    add_test(NAME "codeguard-real.${case}" COMMAND codeguard-real-regression "${case}" "${CODEGUARD_BENCHMARK_REPO_ROOT}/${benchmark_observation}/${case}")
    set_tests_properties("codeguard-real.${case}" PROPERTIES TIMEOUT 30)
endforeach()
